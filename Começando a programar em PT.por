programa
{
	
	funcao inicio()
	{cadeia nome
		escreva("Bem vindo de volta\n")
		escreva("Qual o seu nome?\n")
          leia(nome)
          escreva("\n")
         inteiro maior, idade
         escreva("informe sua idade\n")
         leia(idade)
         se (idade >=18)
         {
         escreva ("voce é de maior\n") 
         escreva ("Esta autorizado a acessar o serviço")
         }
         senao
         escreva ("voce é de menor\nNão pode ter acesso devido a menor idade")
        
		
	}
}
